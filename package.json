{
  "name": "sei-flow",
  "version": "0.1.0",
  "description": "SEI Flow — vincule cartões do Trello a processos do SEI sem sair do SEI.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Leonardo Oliveira",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "sei",
    "trello",
    "extensao",
    "chrome-extension",
    "firefox-extension",
    "gestao-publica"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/engleonardo/SEI.git"
  },
  "bugs": {
    "url": "https://github.com/engleonardo/SEI/issues"
  },
  "homepage": "https://github.com/engleonardo/SEI#readme",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run compile && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
